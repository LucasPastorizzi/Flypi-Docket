# Copie para .env.local e preencha com os valores do seu projeto.
# Project Settings -> API, no painel do Supabase.

# A URL do projeto.
VITE_SUPABASE_URL=

# A anon (publishable) key. Ela É pública: vai no bundle que o navegador
# baixa, e qualquer pessoa consegue lê-la. O que impede vazamento não é ela
# ser secreta — é o RLS, que não devolve linha nenhuma para quem não tem
# direito a ela. Por isso a suíte de banco existe.
VITE_SUPABASE_ANON_KEY=

# A service_role key NÃO entra aqui, nem em nenhuma variável VITE_*. Tudo que
# começa com VITE_ é embutido no bundle em tempo de build. A service_role passa
# por cima de todo o RLS; o lugar dela é a variável de ambiente da Edge
# Function, no servidor.
